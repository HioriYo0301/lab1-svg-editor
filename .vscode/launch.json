{
  "version": "0.2.0",
  "configurations": [{
    "name": "SVG Lab: Extension Development Host",
    "type": "extensionHost",
    "request": "launch",
    "args": ["--extensionDevelopmentPath=${workspaceFolder}/vscode-extension", "${workspaceFolder}/vscode-extension/examples"],
    "outFiles": ["${workspaceFolder}/vscode-extension/out/**/*.js"],
    "preLaunchTask": "compile-svg-extension"
  }]
}
