{
  "name": "lab1-svg-editor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "cli": "tsx src/main.ts",
    "cli:config": "tsx src/main.ts --config plugins.config.json",
    "cli:base": "tsx src/main.ts --config plugins.disabled.config.json",
    "verify:assembly": "node scripts/verify-assembly.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "metrics": "node scripts/metrics.mjs"
  },
  "dependencies": {
    "fast-xml-parser": "^5.2.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
